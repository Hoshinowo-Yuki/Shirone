---
import { getEntry, render } from "astro:content";
import Card from "@components/atoms/display/Card.svelte";
import Markdown from "@components/content/Markdown.astro";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getMarkdownStylesheetAssets } from "@utils/markdown-assets";

const privacyPoliciesPost = await getEntry("spec", "privacy-policies");

if (!privacyPoliciesPost) {
	throw new Error("Privacy policies page content not found");
}

const { Content, remarkPluginFrontmatter } = await render(privacyPoliciesPost);
const markdownStylesheetAssets = await getMarkdownStylesheetAssets(
	remarkPluginFrontmatter.markdownSyntaxes,
);
---
<MainGridLayout title={i18n(I18nKey.privacyPolicies)} description={i18n(I18nKey.privacyPolicies)} page="privacyPolicies">
	{markdownStylesheetAssets.map(({ pack, css }) => <style is:inline slot="head" data-swup-optional={pack} set:html={css}></style>)}
	<div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
		<Card color="var(--card-bg)" radius="l" class="z-10 px-9 py-6 relative w-full">
			<Markdown class="mt-2">
				<Content />
			</Markdown>
		</Card>
	</div>
</MainGridLayout>